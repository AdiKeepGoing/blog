<script>
(function() {
  // 仅在桌面端加载 Live2D（屏幕宽度 >= 768px）
  if (window.innerWidth < 768) return;

  var script = document.createElement('script');
  script.src = '/live2dw/lib/L2Dwidget.min.js';
  script.onload = function() {
    L2Dwidget.init({
      "model": {"jsonPath": "/live2dw/assets/hijiki.model.json"},
      "display": {"position": "right", "width": 150, "height": 150, "hOffset": -30, "vOffset": 10},
      "mobile": {"show": false, "scale": 0.5},
      "react": {"opacityDefault": 0.9, "opacityOnHover": 1},
      "log": false,
      "pluginJsPath": "lib/",
      "pluginModelPath": "assets/",
      "pluginRootPath": "live2dw/",
      "tagMode": false
    });
  };
  document.body.appendChild(script);
})();
</script>
